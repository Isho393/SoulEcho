# --- Database ---
DATABASE_URL=postgresql://soulecho_user:soulecho123@127.0.0.1:5432/soulecho

# --- JWT ---
JWT_SECRET_KEY=bdd4a09ebb34e189b97cba1e53e0fde871a44e58395c1a5bda77599410d35bd9
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Admin User ---
# Doit correspondre au "sub" renvoyé par ton provider OIDC
