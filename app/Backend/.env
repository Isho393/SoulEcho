ADMIN_USER_EMAIL=admin@soulecho.local

# --- OIDC (OpenID Connect) ---
# Remplis ces valeurs avec ton provider (Google, Auth0, etc.)
OIDC_ISSUER_URL=TO_FILL
OIDC_CLIENT_ID=TO_FILL
OIDC_CLIENT_SECRET=TO_FILL
OIDC_SCOPE=openid email profile

# --- OpenAI ---
OPENAI_API_KEY=TO_FILL

# --- Stripe (optionnel pour dev) ---
STRIPE_SECRET_KEY=sk_test_TO_FILL
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success
STRIPE_CANCEL_URL=http://localhost:5173/payment/cancel

# --- URLs ---
