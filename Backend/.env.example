# --- Serveur ---
PORT=8000
ENVIRONMENT=dev

# --- Base de données ---
# SQLite (Local rapide) : sqlite+aiosqlite:///./soulecho.db
# PostgreSQL (Production) : postgresql+asyncpg://user:password@localhost:5432/soulecho
DATABASE_URL=sqlite+aiosqlite:///./soulecho.db

# --- Intelligence Artificielle (OpenAI / Anthropic via Proxy) ---
APP_AI_KEY=
APP_AI_BASE_URL=https://api.openai.com/v1

# --- Securité & JWT ---
# Générez une clé avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Authentification (OIDC) ---
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_SCOPE=openid profile email

# --- URLs ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Paiements ---
STRIPE_API_KEY=

# --- Admin Initial ---
ADMIN_USER_ID=
ADMIN_USER_EMAIL=
